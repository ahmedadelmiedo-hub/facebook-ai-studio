# Safe defaults: prepare artifacts only, never publish publicly.
KIDS_CHANNEL_CONFIG=config/kids-channel.json
KIDS_CONTENT_RULES=config/kids-content-rules.json
KIDS_PUBLISH_ENABLED=false
KIDS_PRODUCTION_ENABLED=false
KIDS_TEXT_PROVIDER=mock
KIDS_IMAGE_PROVIDER=disabled
KIDS_VOICE_PROVIDER=disabled
KIDS_VIDEO_PROVIDER=ffmpeg
# Optional provider secrets belong in GitHub Actions Secrets, never in this file.
KIDS_TEXT_API_KEY=
KIDS_VOICE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
